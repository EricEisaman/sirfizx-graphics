---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import { SITE } from "../site-config";
---

<Layout
  title={`${SITE.author.fullName} - Guestbook`}
  description="Leave a message in my guestbook"
  hideCal={true}
>
  <div class="flex flex-col items-center px-4 pt-8 pb-24">
    <div class="w-full max-w-3xl mb-16">
      <BackLink href={`${import.meta.env.BASE_URL}/`} />
    </div>

    <header class="w-full max-w-xl mb-6 text-center">
      <h1 class="text-white text-3xl font-bold tracking-tight mb-3">
        Guestbook
      </h1>
      <p class="text-darkslate-300 text-sm leading-relaxed">
        The guestbook is unavailable on this static GitHub Pages deployment.
      </p>
    </header>
  </div>
</Layout>
